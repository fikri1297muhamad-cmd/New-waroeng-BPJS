
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/staff_profiles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/staff_profiles/$(request.auth.uid)
        ).data.role in ['admin', 'admin 01'];
    }

    function isStaff() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/staff_profiles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/staff_profiles/$(request.auth.uid)
        ).data.role in ['admin', 'admin 01', 'kasir'];
    }

    match /menu_items/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /restaurant_tables/{tableId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /staff_profiles/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isStaff();

      // Pembuatan pesanan hanya melalui backend tepercaya.
      allow create: if false;

      // Staf hanya boleh memperbarui status pesanan.
      // Pembayaran wajib melalui endpoint backend.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status'])
        && request.resource.data.status
          in ['menunggu', 'diproses', 'siap', 'selesai', 'dibatalkan'];

      // Penghapusan pesanan hanya untuk Admin.
      allow delete: if isAdmin();
    }

    match /order_items/{itemId} {
      // Admin dan Kasir boleh membaca rincian pesanan.
      allow read: if isStaff();

      // Penulisan dan penghapusan hanya melalui backend tepercaya.
      allow create, update, delete: if false;
    }
  }
}
